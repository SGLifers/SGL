{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "SGL sharing: Discord identity, immutable map/mode revisions and pinned bundles. Direct private S3 downloads; no CloudFront or always-on servers.",
  "Parameters": {
    "CodeBucket": {
      "Type": "String"
    },
    "CodeKey": {
      "Type": "String"
    },
    "BudgetEmail": {
      "Type": "String",
      "MinLength": 3,
      "MaxLength": 254,
      "AllowedPattern": "[^\\s@]+@[^\\s@]+\\.[^\\s@]+",
      "Description": "Required recipient for cost thresholds and cutoff failures. Confirm monitoring SNS email subscription."
    },
    "MonthlyBudgetUsd": {
      "Type": "Number",
      "Default": 10,
      "MinValue": 1,
      "MaxValue": 10000,
      "Description": "Account-wide monthly USD budget. Notifications are delayed; this is not a hard spending cap."
    },
    "SharingPaused": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Description": "Deployment preserves the persisted pause. Resume only through the budget-control operator script."
    },
    "UseReservedConcurrency": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Description": "Optional API=2 and guard=1 reservations. Enable after quota approval."
    }
  },
  "Conditions": {
    "SharingIsPaused": {
      "Fn::Equals": [
        {
          "Ref": "SharingPaused"
        },
        "true"
      ]
    },
    "UseReservations": {
      "Fn::Equals": [
        {
          "Ref": "UseReservedConcurrency"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "LibraryTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "listPk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "listSk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "ownerPk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "ownerSk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "sk",
            "KeyType": "RANGE"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "Listings",
            "KeySchema": [
              {
                "AttributeName": "listPk",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "listSk",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "Owners",
            "KeySchema": [
              {
                "AttributeName": "ownerPk",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "ownerSk",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "expiresAt",
          "Enabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "SSESpecification": {
          "SSEEnabled": true
        }
      }
    },
    "ContentBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireStaging",
              "Status": "Enabled",
              "Prefix": "staging/",
              "ExpirationInDays": 1,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 1
              },
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        }
      }
    },
    "ContentPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "ContentBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "RequireHTTPS",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "ContentBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${ContentBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Fn::If": [
                "SharingIsPaused",
                {
                  "Sid": "SglBudgetStopTransfers",
                  "Effect": "Deny",
                  "Principal": "*",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion",
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${ContentBucket.Arn}/*"
                  }
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            }
          ]
        }
      }
    },
    "DiscordConfiguration": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "SGL Discord OAuth configuration; configure after deployment. Never distributed with SGL.",
        "SecretString": "{\"clientId\":\"\",\"clientSecret\":\"\"}"
      }
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "ProtocolType": "HTTP"
      }
    },
    "FunctionLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-api"
        },
        "RetentionInDays": 14
      }
    },
    "FunctionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "SglLibrary",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "FunctionLogs",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:Query"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "LibraryTable",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::Sub": "${LibraryTable.Arn}/index/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "${ContentBucket.Arn}/staging/*"
                    },
                    {
                      "Fn::Sub": "${ContentBucket.Arn}/blobs/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": {
                    "Ref": "DiscordConfiguration"
                  }
                },
                {
                  "Effect": "Deny",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "LibraryTable",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAnyValue:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "CONTROL#*"
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ApiFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "Runtime": "python3.13",
        "Architectures": [
          "arm64"
        ],
        "Handler": "app.handler",
        "Role": {
          "Fn::GetAtt": [
            "FunctionRole",
            "Arn"
          ]
        },
        "MemorySize": 1024,
        "Timeout": 60,
        "ReservedConcurrentExecutions": {
          "Fn::If": [
            "UseReservations",
            {
              "Fn::If": [
                "SharingIsPaused",
                0,
                2
              ]
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "TABLE_NAME": {
              "Ref": "LibraryTable"
            },
            "BUCKET_NAME": {
              "Ref": "ContentBucket"
            },
            "DISCORD_SECRET_ARN": {
              "Ref": "DiscordConfiguration"
            },
            "PUBLIC_BASE_URL": {
              "Fn::Sub": "https://${HttpApi}.execute-api.${AWS::Region}.${AWS::URLSuffix}"
            }
          }
        }
      }
    },
    "ApiIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "ApiFunction",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 30000
      }
    },
    "DefaultRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "$default",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "ApiIntegration"
              }
            ]
          ]
        },
        "AuthorizationType": {
          "Fn::If": [
            "SharingIsPaused",
            "AWS_IAM",
            "NONE"
          ]
        }
      }
    },
    "DefaultStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 20,
          "ThrottlingRateLimit": 10
        }
      }
    },
    "InvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "ApiFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApi}/*"
        }
      }
    },
    "MonthlyBudget": {
      "Type": "AWS::Budgets::Budget",
      "Properties": {
        "Budget": {
          "BudgetName": {
            "Fn::Sub": "${AWS::StackName}-monthly"
          },
          "BudgetLimit": {
            "Amount": {
              "Ref": "MonthlyBudgetUsd"
            },
            "Unit": "USD"
          },
          "TimeUnit": "MONTHLY",
          "BudgetType": "COST"
        },
        "NotificationsWithSubscribers": [
          {
            "Notification": {
              "NotificationType": "ACTUAL",
              "ComparisonOperator": "GREATER_THAN",
              "Threshold": 50,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "SubscriptionType": "EMAIL",
                "Address": {
                  "Ref": "BudgetEmail"
                }
              }
            ]
          },
          {
            "Notification": {
              "NotificationType": "ACTUAL",
              "ComparisonOperator": "GREATER_THAN",
              "Threshold": 80,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "SubscriptionType": "EMAIL",
                "Address": {
                  "Ref": "BudgetEmail"
                }
              }
            ]
          },
          {
            "Notification": {
              "NotificationType": "ACTUAL",
              "ComparisonOperator": "GREATER_THAN",
              "Threshold": 100,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "SubscriptionType": "EMAIL",
                "Address": {
                  "Ref": "BudgetEmail"
                }
              },
              {
                "SubscriptionType": "SNS",
                "Address": {
                  "Ref": "BudgetCutoffTopic"
                }
              }
            ]
          }
        ]
      },
      "DependsOn": [
        "BudgetCutoffTopicPolicy",
        "BudgetGuardBudgetSubscription"
      ]
    },
    "BudgetCutoffTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "DisplayName": "SGL budget cutoff"
      }
    },
    "BudgetCutoffTopicPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [
          {
            "Ref": "BudgetCutoffTopic"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "budgets.amazonaws.com"
              },
              "Action": "sns:Publish",
              "Resource": {
                "Ref": "BudgetCutoffTopic"
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:budgets::${AWS::AccountId}:budget/${AWS::StackName}-monthly"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "BudgetAlarmTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "DisplayName": "SGL budget guard failures"
      }
    },
    "BudgetAlarmTopicPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [
          {
            "Ref": "BudgetAlarmTopic"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudwatch.amazonaws.com"
              },
              "Action": "sns:Publish",
              "Resource": {
                "Ref": "BudgetAlarmTopic"
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:${AWS::StackName}-budget-*"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "BudgetAlarmEmail": {
      "Type": "AWS::SNS::Subscription",
      "Properties": {
        "TopicArn": {
          "Ref": "BudgetAlarmTopic"
        },
        "Protocol": "email",
        "Endpoint": {
          "Ref": "BudgetEmail"
        }
      }
    },
    "BudgetFailureQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "MessageRetentionPeriod": 1209600,
        "SqsManagedSseEnabled": true
      }
    },
    "BudgetFailureQueuePolicy": {
      "Type": "AWS::SQS::QueuePolicy",
      "Properties": {
        "Queues": [
          {
            "Ref": "BudgetFailureQueue"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "sns.amazonaws.com"
              },
              "Action": "sqs:SendMessage",
              "Resource": {
                "Fn::GetAtt": [
                  "BudgetFailureQueue",
                  "Arn"
                ]
              },
              "Condition": {
                "ArnEquals": {
                  "aws:SourceArn": {
                    "Ref": "BudgetCutoffTopic"
                  }
                },
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "BudgetGuardLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-budget-guard"
        },
        "RetentionInDays": 14
      }
    },
    "BudgetGuardRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "SglBudgetControls",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "BudgetGuardLogs",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:DeleteItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "LibraryTable",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "ForAllValues:StringEquals": {
                      "dynamodb:LeadingKeys": [
                        "CONTROL#BUDGET",
                        "CONTROL#BUDGET_LOCK"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetBucketPolicy",
                    "s3:PutBucketPolicy"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ContentBucket",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "lambda:GetFunctionConcurrency",
                    "lambda:PutFunctionConcurrency"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ApiFunction",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "BudgetFailureQueue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "apigateway:GET",
                    "apigateway:PATCH"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:apigateway:${AWS::Region}::/apis/${HttpApi}/routes/${DefaultRoute}"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "BudgetGuardFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-budget-guard"
        },
        "Runtime": "python3.13",
        "Architectures": [
          "arm64"
        ],
        "Handler": "budget_guard.handler",
        "Role": {
          "Fn::GetAtt": [
            "BudgetGuardRole",
            "Arn"
          ]
        },
        "MemorySize": 128,
        "Timeout": 60,
        "ReservedConcurrentExecutions": {
          "Fn::If": [
            "UseReservations",
            1,
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "TABLE_NAME": {
              "Ref": "LibraryTable"
            },
            "BUCKET_NAME": {
              "Ref": "ContentBucket"
            },
            "API_FUNCTION_NAME": {
              "Ref": "ApiFunction"
            },
            "BUDGET_TOPIC_ARN": {
              "Ref": "BudgetCutoffTopic"
            },
            "API_ID": {
              "Ref": "HttpApi"
            },
            "API_ROUTE_ID": {
              "Ref": "DefaultRoute"
            },
            "USE_RESERVED_CONCURRENCY": {
              "Ref": "UseReservedConcurrency"
            }
          }
        }
      }
    },
    "BudgetGuardAsyncFailures": {
      "Type": "AWS::Lambda::EventInvokeConfig",
      "Properties": {
        "FunctionName": {
          "Ref": "BudgetGuardFunction"
        },
        "Qualifier": "$LATEST",
        "MaximumEventAgeInSeconds": 3600,
        "MaximumRetryAttempts": 2,
        "DestinationConfig": {
          "OnFailure": {
            "Destination": {
              "Fn::GetAtt": [
                "BudgetFailureQueue",
                "Arn"
              ]
            }
          }
        }
      }
    },
    "BudgetGuardBudgetPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "BudgetGuardFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "sns.amazonaws.com",
        "SourceArn": {
          "Ref": "BudgetCutoffTopic"
        },
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        }
      }
    },
    "BudgetGuardBudgetSubscription": {
      "Type": "AWS::SNS::Subscription",
      "DependsOn": [
        "BudgetGuardBudgetPermission",
        "BudgetFailureQueuePolicy"
      ],
      "Properties": {
        "TopicArn": {
          "Ref": "BudgetCutoffTopic"
        },
        "Protocol": "lambda",
        "Endpoint": {
          "Fn::GetAtt": [
            "BudgetGuardFunction",
            "Arn"
          ]
        },
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "BudgetFailureQueue",
              "Arn"
            ]
          }
        }
      }
    },
    "BudgetReconcileRule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "ScheduleExpression": "rate(5 minutes)",
        "State": "ENABLED",
        "Targets": [
          {
            "Id": "BudgetGuard",
            "Arn": {
              "Fn::GetAtt": [
                "BudgetGuardFunction",
                "Arn"
              ]
            },
            "Input": "{\"action\":\"reconcile\"}"
          }
        ]
      }
    },
    "BudgetGuardSchedulePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "BudgetGuardFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::GetAtt": [
            "BudgetReconcileRule",
            "Arn"
          ]
        },
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        }
      }
    },
