<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SGL.Desktop.MainWindow" Style="{StaticResource {x:Type Window}}" Title="SGL · SplitGate Lifers" Width="1350" Height="900" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <TextBlock Text="SGL" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Gold}" />
            <TextBlock Text="SPLITGATE LIFERS" Margin="16,13,0,0" Foreground="#B9B7D6" />
            <TextBlock x:Name="VersionLabel" Text="0.1.0" HorizontalAlignment="Right" Foreground="#B9B7D6" />
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="CloudSave" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox x:Name="Folder" Grid.Column="1" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="Browse" Click="BrowseFolder" />
                <Button Content="Refresh / capture changes" Click="RefreshClick" />
            </StackPanel>
        </Grid>
        <TabControl Grid.Row="2" x:Name="Tabs">
            <TabItem Header="Gamemodes">
                <Grid x:Name="ModePanes" Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ModeSidebar" Width="320" MinWidth="220" MaxWidth="650" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" MinWidth="560" />
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="INSTALLED MODES" Foreground="#B9B7D6" Margin="0,0,0,10" />
                        <TextBox x:Name="Search" Grid.Row="1" Margin="0,0,0,10" TextChanged="SearchChanged" ToolTip="Filter installed modes" />
                        <ListBox x:Name="Installed" Grid.Row="2" SelectionChanged="ModeSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" ToolTip="{Binding Name}" /></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                            <Button Content="New mode" Click="NewMode" />
                            <Button Content="Import JSON" Click="Import" />
                            <Button Content="Community presets" Click="Presets" />
                            <Button Content="Open draft" Click="OpenDraft" />
                            <Button Content="Export installed pack" Click="ExportPack" />
                            <Button Content="Delete selected mode" Foreground="#FFB9B9" Click="DeleteModeClick" />
                        </WrapPanel>
                    </Grid>
                    <GridSplitter Grid.Column="1" Style="{StaticResource PaneDivider}" AutomationProperties.Name="Resize installed modes sidebar" DragCompleted="PaneResizeCompleted" KeyUp="PaneResizeKeyUp" />
                    <Grid Grid.Column="2" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Mode name" Margin="0,0,0,4" />
                                <TextBox x:Name="ModeName" TextChanged="NameChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Text="New-mode base" Margin="0,0,0,4" />
                                <ComboBox x:Name="Base" SelectedIndex="0">
                                    <ComboBoxItem Content="King of the Hill" Tag="koth" />
                                    <ComboBoxItem Content="Team Deathmatch" Tag="tdm" />
                                    <ComboBoxItem Content="SWAT" Tag="swat" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Grid.Row="1" Margin="0,12,0,12">
                            <Button Content="Loadout" Click="LoadoutCategory" />
                            <Button Content="Randomize loadout" Click="Randomize" />
                            <Button Content="Reset opened values" Click="ResetOpened" />
                            <CheckBox x:Name="LockPrimary" Content="Lock primary" />
                            <CheckBox x:Name="LockSecondary" Content="Lock secondary" />
                            <CheckBox x:Name="LockEquipment" Content="Lock equipment" />
                        </WrapPanel>
                        <Grid x:Name="SettingsPanes" Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="CategorySidebar" Width="135" MinWidth="105" MaxWidth="260" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" MinWidth="420" />
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="Categories" SelectionChanged="CategoryChanged" />
                            <GridSplitter Grid.Column="1" Style="{StaticResource PaneDivider}" AutomationProperties.Name="Resize settings categories" DragCompleted="PaneResizeCompleted" KeyUp="PaneResizeKeyUp" />
                            <ScrollViewer x:Name="SettingsScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
                                <StackPanel x:Name="Rows" />
                            </ScrollViewer>
                        </Grid>
                        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                            <Button x:Name="SaveButton" Content="Save to game" Background="{StaticResource Gold}" Foreground="#171027" Click="SaveToGame" />
                            <Button Content="Save draft" Click="SaveDraft" />
                            <Button Content="Export JSON" Click="Export" />
                            <Button Content="Duplicate" Click="Duplicate" />
                            <TextBlock x:Name="DirtyLabel" VerticalAlignment="Center" Foreground="#F3BE4F" Margin="6" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="MapsTab" Header="Maps">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <Button x:Name="RefreshCatalogButton" Content="Refresh community catalog" Click="RefreshCatalogClick" />
                        <Button Content="Import map .bin" Click="ImportMapClick" />
                        <Button Content="Community map website" Click="MapWebsiteClick" />
                    </WrapPanel>
                    <TextBlock x:Name="MapStatus" Grid.Row="1" Text="Browse community maps or import a map .bin. Close Splitgate to install. Backups are made automatically." TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#B9B7D6" />
                    <Grid x:Name="MapPanes" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition x:Name="MapDetailsPane" Width="380" MinWidth="280" MaxWidth="750" />
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="COMMUNITY MAPS" Foreground="#B9B7D6" Margin="0,0,0,8" />
                            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                                <ComboBox x:Name="MapCategory" Width="140" Margin="8,0,0,0" DockPanel.Dock="Right" SelectionChanged="MapFilterChanged" />
                                <TextBox x:Name="MapSearch" ToolTip="Search map name or author" TextChanged="MapSearchChanged" />
                            </DockPanel>
                            <ListBox x:Name="CommunityMaps" Grid.Row="2" SelectionChanged="CommunityMapSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5,7">
                                            <TextBlock Text="{Binding Name}" FontSize="15" TextWrapping="Wrap" />
                                            <TextBlock Foreground="#B9B7D6"><Run Text="{Binding Author}" /><Run Text=" · " /><Run Text="{Binding Category}" /></TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <GridSplitter Grid.Column="1" Style="{StaticResource PaneDivider}" AutomationProperties.Name="Resize installed maps and details" DragCompleted="PaneResizeCompleted" KeyUp="PaneResizeKeyUp" />
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
                            <StackPanel>
                                <Image x:Name="MapPreview" Height="180" Stretch="Uniform" Margin="0,0,0,10" />
                                <TextBlock x:Name="MapDetails" Text="Select a community map." TextWrapping="Wrap" Margin="0,0,0,10" />
                                <Button x:Name="InstallMapButton" Content="Install selected map" Background="{StaticResource Gold}" Foreground="#171027" Click="InstallMapClick" IsEnabled="False" />
                                <Button x:Name="CancelMapButton" Content="Cancel download" Click="CancelMapClick" IsEnabled="False" />
                                <TextBlock Text="INSTALLED MAPS" Foreground="#B9B7D6" Margin="0,20,0,8" />
                                <ListBox x:Name="InstalledMaps" Height="150" SelectionChanged="InstalledMapSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" ToolTip="{Binding Name}" /></DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="Delete selected map" Foreground="#FFB9B9" Click="DeleteMapClick" Margin="0,8,8,6" />
                                <TextBlock Text="Associated gamemodes" FontSize="16" Margin="0,18,0,8" />
                                <TextBlock Text="Choose an installed map and a mode to link them. Select both separately in the game lobby." TextWrapping="Wrap" Foreground="#B9B7D6" Margin="0,0,0,8" />
                                <ComboBox x:Name="MapModeChoice" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,6" />
                                <WrapPanel>
                                    <Button Content="Associate" Click="AssociateMapMode" />
                                    <Button Content="Remove link" Click="UnlinkMapMode" />
                                </WrapPanel>
                                <ListBox x:Name="AssociatedModes" DisplayMemberPath="Name" Height="100" Margin="0,8,0,0" MouseDoubleClick="OpenAssociatedMode" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="History">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Local Git history · select any two snapshots to compare. Restore affects the selected mode only." TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="BeforeRevision" Margin="0,0,12,12" SelectionChanged="RevisionChanged" />
                        <ComboBox x:Name="AfterRevision" Grid.Column="1" Margin="0,0,12,12" SelectionChanged="RevisionChanged" />
                        <Button Grid.Column="2" Content="Restore selected mode from older snapshot" Click="RestoreRevision" />
                    </Grid>
                    <TextBox Grid.Row="2" x:Name="DiffText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                </Grid>
            </TabItem>
            <TabItem Header="Backups">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Restoring a manifest snapshot changes the complete installed maps and modes list to that point in time. Later registrations will disappear. A safety backup is made first." TextWrapping="Wrap" Margin="0,0,0,14" />
                    <ListBox x:Name="Backups" Grid.Row="1" />
                    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button Content="Open backup folder" Click="OpenBackupFolder" />
                        <Button Content="Restore selected backup" Click="RestoreBackup" />
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Settings &amp; help">
                <StackPanel Margin="24">
                    <TextBlock Text="SGL · community tools" FontSize="24" Margin="0,0,0,16" />
                    <TextBlock Text="Gamemode editing and Git history work offline. Close Splitgate before applying configurations. Changes made in-game are captured on refresh or the next SGL launch." TextWrapping="Wrap" Margin="0,0,0,16" />
                    <CheckBox x:Name="AutoUpdate" Content="Automatically check, download and apply verified releases at startup" Click="UpdatePreference" />
                    <WrapPanel Margin="0,12,0,12">
                        <Button Content="Check for updates" Click="CheckUpdates" />
                        <Button Content="Setup &amp; Windows Security guide" Click="OpenGuide" />
                        <Button Content="Open SGL data folder" Click="OpenData" />
                        <Button Content="Reset pane widths" Click="ResetPaneWidths" />
                    </WrapPanel>
                    <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" />
                    <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" Text="Unsigned releases may require review in Windows Security → Virus &amp; threat protection → Protection history. Only allow the official release you have verified. SGL never changes security settings." />
                    <TextBlock Margin="0,20,0,0" Foreground="#B9B7D6" Text="Drag the vertical dividers to resize lists and editor panes. SGL remembers your widths." />
                </StackPanel>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="Status" Grid.Row="3" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#B9B7D6" />
    </Grid>
</Window>
