<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SGL.Desktop.MainWindow" Style="{StaticResource {x:Type Window}}" Title="SGL · SplitGate Lifers" Width="1350" Height="900" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <TextBlock Text="SGL" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Gold}" />
            <TextBlock Text="SPLITGATE LIFERS" Margin="16,13,0,0" Foreground="#B9B7D6" />
            <TextBlock x:Name="VersionLabel" Text="0.1.0" HorizontalAlignment="Right" Foreground="#B9B7D6" />
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="CloudSave" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox x:Name="Folder" Grid.Column="1" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="Browse" Click="BrowseFolder" />
                <Button Content="Refresh / capture changes" Click="RefreshClick" />
            </StackPanel>
        </Grid>
        <TabControl Grid.Row="2" x:Name="Tabs">
            <TabItem Header="Gamemodes">
                <Grid x:Name="ModePanes" Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ModeSidebar" Width="320" MinWidth="220" MaxWidth="650" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" MinWidth="560" />
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="INSTALLED MODES" Foreground="#B9B7D6" Margin="0,0,0,10" />
                        <TextBox x:Name="Search" Grid.Row="1" Margin="0,0,0,10" TextChanged="SearchChanged" ToolTip="Filter installed modes" />
                        <ListBox x:Name="Installed" Grid.Row="2" SelectionChanged="ModeSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" ToolTip="{Binding Name}" /></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                            <Button Content="New mode" Click="NewMode" />
                            <Button Content="Import JSON" Click="Import" />
                            <Button Content="Community presets" Click="Presets" />
                            <Button Content="Open draft" Click="OpenDraft" />
                            <Button Content="Export installed pack" Click="ExportPack" />
                            <Button Content="Delete selected mode" Foreground="#FFB9B9" Click="DeleteModeClick" />
                        </WrapPanel>
                    </Grid>
                    <GridSplitter Grid.Column="1" Style="{StaticResource PaneDivider}" AutomationProperties.Name="Resize installed modes sidebar" DragCompleted="PaneResizeCompleted" KeyUp="PaneResizeKeyUp" />
                    <Grid Grid.Column="2" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Mode name" Margin="0,0,0,4" />
                                <TextBox x:Name="ModeName" TextChanged="NameChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Text="New-mode base" Margin="0,0,0,4" />
                                <ComboBox x:Name="Base" SelectedIndex="0">
                                    <ComboBoxItem Content="King of the Hill" Tag="koth" />
                                    <ComboBoxItem Content="Team Deathmatch" Tag="tdm" />
                                    <ComboBoxItem Content="SWAT" Tag="swat" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Grid.Row="1" Margin="0,12,0,12">
                            <Button Content="Loadout" Click="LoadoutCategory" />
                            <Button Content="Randomize loadout" Click="Randomize" />
                            <Button Content="Reset opened values" Click="ResetOpened" />
                            <CheckBox x:Name="LockPrimary" Content="Lock primary" />
                            <CheckBox x:Name="LockSecondary" Content="Lock secondary" />
                            <CheckBox x:Name="LockEquipment" Content="Lock equipment" />
                        </WrapPanel>
                        <Grid x:Name="SettingsPanes" Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="CategorySidebar" Width="135" MinWidth="105" MaxWidth="260" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" MinWidth="420" />
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="Categories" SelectionChanged="CategoryChanged" />
                            <GridSplitter Grid.Column="1" Style="{StaticResource PaneDivider}" AutomationProperties.Name="Resize settings categories" DragCompleted="PaneResizeCompleted" KeyUp="PaneResizeKeyUp" />
                            <ScrollViewer x:Name="SettingsScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
                                <StackPanel x:Name="Rows" />
                            </ScrollViewer>
                        </Grid>
                        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                            <Button x:Name="SaveButton" Content="Save to game" Background="{StaticResource Gold}" Foreground="#171027" Click="SaveToGame" />
                            <Button Content="Save draft" Click="SaveDraft" />
                            <Button Content="Export JSON" Click="Export" />
                            <Button Content="Duplicate" Click="Duplicate" />
                            <Button Content="Share mode" Click="ShareEditorMode" />
                            <TextBlock x:Name="DirtyLabel" VerticalAlignment="Center" Foreground="#F3BE4F" Margin="6" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="MapsTab" Header="Maps">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <Button x:Name="RefreshCatalogButton" Content="Refresh community catalog" Click="RefreshCatalogClick" />
                        <Button Content="Import map .bin" Click="ImportMapClick" />
                        <Button Content="Community map website" Click="MapWebsiteClick" />
                        <TextBlock Text="Tag" VerticalAlignment="Center" Margin="8,0,8,6" />
                        <ComboBox x:Name="MapTagFilter" Width="180" DisplayMemberPath="Name" ToolTip="Filter community and installed maps by a local tag" Margin="0,0,8,6" SelectionChanged="MapTagFilterChanged" />
                        <Button x:Name="EditMapTagsButton" Content="Edit local tags…" Click="EditMapTags" IsEnabled="False" ToolTip="Select a community or installed map to edit its tags" />
                    </WrapPanel>
                    <TextBlock x:Name="MapStatus" Grid.Row="1" Text="Browse community maps or import a map .bin. Close Splitgate to install. Backups are made automatically." TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#B9B7D6" />
                    <Grid x:Name="MapPanes" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition x:Name="MapDetailsPane" Width="380" MinWidth="280" MaxWidth="750" />
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="COMMUNITY MAPS" Foreground="#B9B7D6" Margin="0,0,0,8" />
                            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                                <ComboBox x:Name="MapCategory" Width="140" Margin="8,0,0,0" DockPanel.Dock="Right" SelectionChanged="MapFilterChanged" />
                                <TextBox x:Name="MapSearch" ToolTip="Search map name, author or local tags" TextChanged="MapSearchChanged" />
                            </DockPanel>
                            <ListBox x:Name="CommunityMaps" Grid.Row="2" SelectionChanged="CommunityMapSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5,7">
                                            <TextBlock Text="{Binding Name}" FontSize="15" TextWrapping="Wrap" />
                                            <TextBlock Foreground="#B9B7D6"><Run Text="{Binding Author}" /><Run Text=" · " /><Run Text="{Binding Category}" /></TextBlock>
                                            <TextBlock Text="{Binding TagSummary}" Foreground="{StaticResource Gold}" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <GridSplitter Grid.Column="1" Style="{StaticResource PaneDivider}" AutomationProperties.Name="Resize installed maps and details" DragCompleted="PaneResizeCompleted" KeyUp="PaneResizeKeyUp" />
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
                            <StackPanel>
                                <Image x:Name="MapPreview" Height="180" Stretch="Uniform" Margin="0,0,0,10" />
                                <TextBlock x:Name="MapDetails" Text="Select a community map." TextWrapping="Wrap" Margin="0,0,0,10" />
                                <TextBlock x:Name="MapTagTitle" Text="Local tags" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock x:Name="MapTagDetails" Text="Select a map to edit its tags." Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <Button x:Name="InstallMapButton" Content="Install selected map" Background="{StaticResource Gold}" Foreground="#171027" Click="InstallMapClick" IsEnabled="False" />
                                <Button x:Name="CancelMapButton" Content="Cancel download" Click="CancelMapClick" IsEnabled="False" />
                                <TextBlock Text="INSTALLED MAPS" Foreground="#B9B7D6" Margin="0,20,0,8" />
                                <TextBox x:Name="InstalledMapSearch" ToolTip="Search installed maps by name, author or local tags" TextChanged="InstalledMapSearchChanged" Margin="0,0,0,8" />
                                <ListBox x:Name="InstalledMaps" Height="150" SelectionChanged="InstalledMapSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap" ToolTip="{Binding Name}" /><TextBlock Text="{Binding TagSummary}" Foreground="{StaticResource Gold}" FontSize="12" TextWrapping="Wrap" /></StackPanel></DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="Delete selected map" Foreground="#FFB9B9" Click="DeleteMapClick" Margin="0,8,8,6" />
                                <TextBlock Text="Associated gamemodes" FontSize="16" Margin="0,18,0,8" />
                                <TextBlock Text="Choose an installed map and a mode to link them. Select both separately in the game lobby." TextWrapping="Wrap" Foreground="#B9B7D6" Margin="0,0,0,8" />
                                <ComboBox x:Name="MapModeChoice" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,6" />
                                <WrapPanel>
                                    <Button Content="Associate" Click="AssociateMapMode" />
                                    <Button Content="Remove link" Click="UnlinkMapMode" />
                                </WrapPanel>
                                <ListBox x:Name="AssociatedModes" DisplayMemberPath="Name" Height="100" Margin="0,8,0,0" MouseDoubleClick="OpenAssociatedMode" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="SharedTab" Header="Shared library">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="Sign in with Discord" Click="LibrarySignIn" />
                        <Button Content="Sign out" Click="LibrarySignOut" />
                        <Button Content="Cancel" Click="LibraryCancel" />
                        <TextBlock x:Name="LibraryAccount" VerticalAlignment="Center" Margin="8,0" />
                    </WrapPanel>
                    <TextBlock x:Name="LibraryStatus" Grid.Row="1" Text="Public maps, modes and bundles. Local editing stays offline; publishing is explicit." Foreground="#B9B7D6" TextWrapping="Wrap" Margin="0,6,0,12" />
                    <TabControl x:Name="LibraryPages" Grid.Row="2">
                        <TabItem Header="Browse">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="350" MinWidth="240" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" MinWidth="400" />
                                </Grid.ColumnDefinitions>
                                <Grid Margin="0,0,8,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <WrapPanel>
                                        <Button Content="Refresh" Click="LibraryRefresh" />
                                        <CheckBox x:Name="LibraryMine" Content="My publications" Click="LibraryRefresh" />
                                    </WrapPanel>
                                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                        <TextBlock Text="Tag (exact label)" FontSize="12" Foreground="#B9B7D6" /><TextBox x:Name="LibraryTag" MaxLength="40" KeyDown="LibraryFilterKeyDown" Margin="0,4,0,8" />
                                        <TextBlock Text="Publisher name or Discord ID" FontSize="12" Foreground="#B9B7D6" /><TextBox x:Name="LibraryCreator" MaxLength="100" KeyDown="LibraryFilterKeyDown" Margin="0,4,0,8" />
                                        <WrapPanel><Button x:Name="ApplyLibraryFiltersButton" Content="Apply filters" Click="LibraryRefresh" /><Button x:Name="ClearLibraryFiltersButton" Content="Clear filters" Click="LibraryClearFilters" /></WrapPanel>
                                        <TextBlock Text="Search loaded results" FontSize="12" Foreground="#B9B7D6" /><TextBox x:Name="LibrarySearch" TextChanged="LibrarySearchChanged" ToolTip="Search loaded items by title, description, creator or tags" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <ListBox x:Name="LibraryItems" Grid.Row="2" SelectionChanged="LibraryItemSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" TextWrapping="Wrap" /><TextBlock Text="{Binding Label}" Foreground="#B9B7D6" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding TagSummary}" Foreground="{StaticResource Gold}" FontSize="12" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <WrapPanel Grid.Row="3" Margin="0,8,0,0"><Button Content="Load more" Click="LibraryMore" /><Button Content="Import package" Click="LibraryImportPackage" /></WrapPanel>
                                </Grid>
                                <GridSplitter Grid.Column="1" Style="{StaticResource PaneDivider}" AutomationProperties.Name="Resize shared library list" />
                                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Open a shared link" Margin="0,0,0,6" />
                                        <DockPanel><Button DockPanel.Dock="Right" Content="Open" Click="LibraryOpenLink" Margin="8,0,0,6" /><TextBox x:Name="LibraryLink" ToolTip="Paste an SGL share link or item identity" /></DockPanel>
                                        <TextBlock x:Name="LibraryDetails" Text="Select a shared item." TextWrapping="Wrap" Margin="0,16,0,12" />
                                        <TextBlock Text="Selected revision" Margin="0,0,0,4" />
                                        <ComboBox x:Name="LibraryRevisions" DisplayMemberPath="Label" Margin="0,0,0,6" SelectionChanged="SharedRevisionSelected" />
                                        <TextBlock x:Name="LibraryRevisionAttribution" Foreground="#B9B7D6" TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <TextBlock Text="Compare with revision" Margin="0,0,0,4" />
                                        <ComboBox x:Name="LibraryCompareRevision" DisplayMemberPath="Label" Margin="0,0,0,10" />
                                        <Button Content="Load older revisions" Click="LibraryOlderRevisions" HorizontalAlignment="Left" />
                                        <WrapPanel>
                                            <Button Content="Install selected revision" Background="{StaticResource Gold}" Foreground="#171027" Click="LibraryInstall" />
                                            <Button Content="Compare local mode" Click="LibraryCompare" />
                                            <Button Content="Compare revisions" Click="LibraryCompareVersions" />
                                            <Button Content="Copy share link" Click="LibraryCopyLink" />
                                            <Button Content="Creator's Discord profile" Click="LibraryCreatorProfile" />
                                            <Button Content="Export package" Click="LibraryExport" />
                                        </WrapPanel>
                                        <TextBox x:Name="LibraryDiff" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Height="180" VerticalScrollBarVisibility="Auto" Margin="0,8,0,12" />
                                        <TextBlock Text="Portable sharing" FontSize="18" Margin="0,12,0,8" />
                                        <TextBlock Text="Export local content from Publish, or import a .sglpack file. Packages contain content and credits; account attribution in an offline file is not authenticated." TextWrapping="Wrap" Foreground="#B9B7D6" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Publish">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20" MaxWidth="850" HorizontalAlignment="Stretch">
                                    <TextBlock Text="Publish selected content" FontSize="20" Margin="0,0,0,12" />
                                    <TextBlock Text="Content" /><ComboBox x:Name="PublishKind" SelectedIndex="1" Margin="0,5,0,10" SelectionChanged="PublishKindChanged"><ComboBoxItem Content="Map" Tag="map" /><ComboBoxItem Content="Gamemode" Tag="mode" /><ComboBoxItem Content="Map + gamemode bundle" Tag="bundle" /></ComboBox>
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedItem.Tag, ElementName=PublishKind}" Value="mode">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Local map" /><ComboBox x:Name="PublishMap" DisplayMemberPath="Name" Margin="0,5,0,10" SelectionChanged="PublishSourceChanged" />
                                        <TextBlock x:Name="PublishMapTags" Text="Map tags are included when publishing or exporting." TextWrapping="Wrap" Foreground="{StaticResource Gold}" Margin="0,0,0,10" />
                                    </StackPanel>
                                    <TextBlock Text="Local gamemode" /><ComboBox x:Name="PublishMode" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,5,0,10" SelectionChanged="PublishSourceChanged" />
                                    <TextBlock Text="Publication" /><ComboBox x:Name="PublishAction" SelectedIndex="0" Margin="0,5,0,10"><ComboBoxItem Content="New item" Tag="new" /><ComboBoxItem Content="New revision of selected shared item" Tag="update" /><ComboBoxItem Content="My own version of selected shared item" Tag="fork" /></ComboBox>
                                    <TextBlock Text="Title" /><TextBox x:Name="PublishTitle" MaxLength="120" Margin="0,5,0,10" />
                                    <TextBlock Text="Description" /><TextBox x:Name="PublishDescription" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" Height="75" VerticalContentAlignment="Top" Margin="0,5,0,10" />
                                    <TextBlock Text="Original creator credits" /><TextBox x:Name="PublishCredits" MaxLength="1000" Margin="0,5,0,10" />
                                    <TextBlock Text="What changed?" /><TextBox x:Name="PublishNote" Text="Initial publication" MaxLength="1000" Margin="0,5,0,10" />
                                    <TextBlock Text="Visibility" /><ComboBox x:Name="PublishVisibility" SelectedIndex="0" Margin="0,5,0,12"><ComboBoxItem Content="Unlisted · anyone with the link" Tag="unlisted" /><ComboBoxItem Content="Public · shown in the community library" Tag="public" /><ComboBoxItem Content="Private · only your account" Tag="private" /></ComboBox>
                                    <TextBlock Text="A bundle publishes the selected map and mode as needed, then pins their exact revisions. Existing creator credits are retained. Game-save ownership and local file paths are not uploaded." TextWrapping="Wrap" Foreground="#B9B7D6" Margin="0,0,0,12" />
                                    <WrapPanel><Button Content="Publish" Background="{StaticResource Gold}" Foreground="#171027" Click="LibraryPublish" /><Button Content="Export local package" Click="LibraryExportLocal" /></WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
            <TabItem Header="History">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Local Git history · select any two snapshots to compare. Restore affects the selected mode only." TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="BeforeRevision" Margin="0,0,12,12" SelectionChanged="RevisionChanged" />
                        <ComboBox x:Name="AfterRevision" Grid.Column="1" Margin="0,0,12,12" SelectionChanged="RevisionChanged" />
                        <Button Grid.Column="2" Content="Restore selected mode from older snapshot" Click="RestoreRevision" />
                    </Grid>
                    <TextBox Grid.Row="2" x:Name="DiffText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                </Grid>
            </TabItem>
            <TabItem Header="Backups">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Restoring a manifest snapshot changes the complete installed maps and modes list to that point in time. Later registrations will disappear. A safety backup is made first." TextWrapping="Wrap" Margin="0,0,0,14" />
                    <ListBox x:Name="Backups" Grid.Row="1" />
                    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button Content="Open backup folder" Click="OpenBackupFolder" />
                        <Button Content="Restore selected backup" Click="RestoreBackup" />
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Settings &amp; help">
                <StackPanel Margin="24">
                    <TextBlock Text="SGL · community tools" FontSize="24" Margin="0,0,0,16" />
                    <TextBlock Text="Gamemode editing and Git history work offline. Close Splitgate before applying configurations. Changes made in-game are captured on refresh or the next SGL launch." TextWrapping="Wrap" Margin="0,0,0,16" />
                    <CheckBox x:Name="AutoUpdate" Content="Automatically check, download and apply verified releases at startup" Click="UpdatePreference" />
                    <WrapPanel Margin="0,12,0,12">
                        <Button Content="Check for updates" Click="CheckUpdates" />
                        <Button Content="Setup &amp; Windows Security guide" Click="OpenGuide" />
                        <Button Content="Report a bug" Click="ReportBug" />
                        <Button Content="Open SGL data folder" Click="OpenData" />
                        <Button Content="Reset pane widths" Click="ResetPaneWidths" />
                    </WrapPanel>
                    <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" />
                    <TextBlock Text="Sharing service" Margin="0,20,0,6" />
                    <DockPanel><Button DockPanel.Dock="Right" Content="Save service URL" Click="SaveLibraryService" Margin="8,0,0,6" /><TextBox x:Name="LibraryServiceUrl" ToolTip="HTTPS service URL from the SGL sharing deployment" /></DockPanel>
                    <Button Content="Enable Open in SGL links" Click="EnableSharedLinks" HorizontalAlignment="Left" Margin="0,8,8,6" />
                    <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" Text="Unsigned releases may require review in Windows Security → Virus &amp; threat protection → Protection history. Only allow the official release you have verified. SGL never changes security settings." />
                    <TextBlock Margin="0,20,0,0" Foreground="#B9B7D6" Text="Drag the vertical dividers to resize lists and editor panes. SGL remembers your widths." />
                </StackPanel>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="Status" Grid.Row="3" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#B9B7D6" />
    </Grid>
</Window>
