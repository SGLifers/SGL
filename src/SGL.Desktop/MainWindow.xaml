<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:SGL.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SGL.Desktop.MainWindow" Style="{StaticResource {x:Type Window}}" Title="SGL · SplitGate Lifers" Width="1350" Height="900" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <TextBlock Text="SGL" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Gold}" />
            <TextBlock Text="SPLITGATE LIFERS" Margin="16,13,0,0" Foreground="#B9B7D6" />
            <TextBlock x:Name="VersionLabel" Text="0.1.0" HorizontalAlignment="Right" Foreground="#B9B7D6" />
        </DockPanel>
        <TabControl Grid.Row="1" x:Name="Tabs" Style="{StaticResource MainNavigation}">
            <TabItem x:Name="HostingTab" Header="Hosting">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,8,12,16">
                        <TextBlock Text="Hosting" FontSize="24" Margin="0,0,0,16"/>
                        <DockPanel Margin="0,0,0,10"><Button x:Name="HostingSignInButton" DockPanel.Dock="Right" Content="Sign in with Discord" Click="HostingSignIn"/><TextBlock x:Name="HostingAccount" VerticalAlignment="Center" Foreground="#B9B7D6"/></DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Lobby name" Margin="0,0,0,5"/><TextBox x:Name="HostingLobbyName" MaxLength="80" Height="44" FontSize="18" TextChanged="HostingCodeChanged" AutomationProperties.Name="Lobby name" ToolTip="Optional name included with new lobby announcements"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Lobby code" Margin="0,0,0,5"/><TextBox x:Name="HostingLobbyCode" Width="160" MaxLength="6" Height="44" CharacterCasing="Upper" TextChanged="HostingCodeChanged" FontSize="22" FontFamily="Consolas" HorizontalContentAlignment="Center" AutomationProperties.Name="Lobby code" ToolTip="Six letters or numbers"/></StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Gamemode" Margin="0,0,0,5"/><ComboBox x:Name="HostingGamemodeSource" SelectedIndex="0" SelectionChanged="HostingGamemodeChanged" AutomationProperties.Name="Gamemode source"><ComboBoxItem Content="Unset" Tag="unset"/><ComboBoxItem Content="SpinGate" Tag="spingate"/><ComboBoxItem Content="Custom" Tag="custom"/></ComboBox></StackPanel>
                            <StackPanel Grid.Column="2" x:Name="HostingCustomGamemodePanel" Visibility="Collapsed"><TextBlock Text="Custom gamemode" Margin="0,0,0,5"/><TextBox x:Name="HostingCustomGamemode" MaxLength="120" TextChanged="HostingGamemodeChanged" AutomationProperties.Name="Custom gamemode"/></StackPanel>
                        </Grid>
                        <StackPanel Margin="0,12,0,0"><TextBlock Text="Map" Margin="0,0,0,5"/><TextBox x:Name="HostingLobbyMap" MaxLength="120" TextChanged="HostingGamemodeChanged" AutomationProperties.Name="Lobby map" ToolTip="Filled by SpinGate; you can also enter a map name"/></StackPanel>
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="HostingOpenLobbyButton" Content="Open Lobby" Click="HostingOpenLobby" IsEnabled="False" Background="{StaticResource Gold}" Foreground="#171027" MinWidth="130" Margin="0,0,10,0"/>
                            <Button x:Name="HostingCloseLobbyButton" Content="Close Lobby" Click="HostingCloseLobby" IsEnabled="False" MinWidth="130"/>
                            <Button x:Name="HostingUpdateGamemodeButton" Content="Update details" Click="HostingUpdateGamemode" Visibility="Collapsed" IsEnabled="False"/>
                        </WrapPanel>
                        <TextBlock Text="Open Lobby posts to Discord. Close Lobby marks that announcement closed. These buttons do not control the lobby in-game." Foreground="#B9B7D6" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock x:Name="HostingAnnouncementStatus" TextWrapping="Wrap" Foreground="#F3BE4F" Margin="0,6,0,24"/>
                        <TextBlock Text="SpinGate" FontSize="22" Margin="0,0,0,10"/>
                        <TextBlock Text="Rotation preset" Margin="0,0,0,5"/>
                        <ComboBox x:Name="HostingPreset" SelectionChanged="HostingPresetChanged"/>
                        <Grid Margin="0,18,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="GAMEMODE" Foreground="#B9B7D6"/><TextBlock x:Name="HostingSpinMode" Text="Ready to spin" FontSize="26" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,6,0,8"/><Button x:Name="CopyHostingModeButton" Content="Copy gamemode" Click="CopyHostingMode" HorizontalAlignment="Left" IsEnabled="False"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="MAP" Foreground="#B9B7D6"/><TextBlock x:Name="HostingSpinMap" Text="—" FontSize="26" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,6,0,8"/><Button x:Name="CopyHostingMapButton" Content="Copy map" Click="CopyHostingMap" HorizontalAlignment="Left" IsEnabled="False"/></StackPanel>
                        </Grid>
                        <Button x:Name="HostingSpinButton" Content="Spin" Click="HostingSpinClick" Background="{StaticResource Gold}" Foreground="#171027" HorizontalAlignment="Left" MinWidth="140"/>
                        <TextBlock x:Name="HostingSpinStatus" Text="Choose Spin to get started." Foreground="#B9B7D6" TextWrapping="Wrap" Margin="0,8,0,18"/>
                        <Expander Header="Configure rotation" Foreground="#B9B7D6" IsExpanded="False">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Presets" FontSize="18"/>
                                <TextBox x:Name="HostingPresetName" MaxLength="120" Margin="0,6,0,6" ToolTip="Name for a copy of the selected preset"/>
                                <WrapPanel><Button Content="Copy selected preset" Click="CopyHostingPreset"/><Button Content="Delete selected preset" Click="DeleteHostingPreset"/><Button Content="Restore built-in preset" Click="RestoreHostingPreset"/></WrapPanel>
                                <TextBlock Text="Gamemodes · one per line" FontSize="18" Margin="0,16,0,6"/>
                                <TextBox x:Name="HostingModesInput" AcceptsReturn="True" Height="150" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                                <WrapPanel Margin="0,8,0,0"><Button Content="Save gamemodes" Click="SaveHostingModes"/><Button Content="Add installed gamemodes" Click="AddInstalledHostingModes"/></WrapPanel>
                                <TextBlock Text="Map lists" FontSize="18" Margin="0,16,0,6"/>
                                <ComboBox x:Name="HostingMapLists" SelectionChanged="HostingMapListSelected"/>
                                <TextBlock Text="Map list name" Margin="0,8,0,5"/><TextBox x:Name="HostingMapListName" MaxLength="120"/>
                                <TextBlock Text="Maps · one per line" Margin="0,8,0,5"/><TextBox x:Name="HostingMapsInput" AcceptsReturn="True" Height="150" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                                <WrapPanel Margin="0,8,0,0"><Button Content="Save map list" Click="SaveHostingMapList"/><Button Content="New map list" Click="NewHostingMapList"/><Button Content="Delete map list" Click="DeleteHostingMapList"/><Button Content="Use installed maps" Click="UseInstalledHostingMaps"/></WrapPanel>
                                <TextBlock Text="Link gamemodes to map lists" FontSize="18" Margin="0,16,0,6"/>
                                <ComboBox x:Name="HostingAssignedMode" SelectionChanged="HostingAssignedModeChanged" Margin="0,0,0,6"/>
                                <ListBox x:Name="HostingAssignedLists" SelectionMode="Multiple" MaxHeight="180"/>
                                <Button Content="Save selected map-list links" Click="SaveHostingLinks" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Gamemodes" x:Name="ModesTab">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Close Splitgate to change gamemodes; changes apply on the next game launch." TextWrapping="Wrap" Foreground="#B9B7D6" Margin="16,8,0,8"/>
                <TabControl Grid.Row="1" Margin="0" SelectionChanged="ContentViewChanged" x:Name="ModeViews" Style="{StaticResource WorkspaceViews}">
                    <TabItem Header="Installed">
                        <Grid x:Name="ModePanes" Margin="8" TextElement.FontWeight="Normal">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ModeSidebar" Width="320" MinWidth="220" MaxWidth="650" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" MinWidth="560" />
                            </Grid.ColumnDefinitions>
                            <Grid Margin="0,0,8,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="INSTALLED MODES" Foreground="#B9B7D6" Margin="0,0,0,10" />
                                <TextBox x:Name="Search" Grid.Row="1" Margin="0,0,0,10" TextChanged="SearchChanged" ToolTip="Filter installed modes" />
                                <ListBox x:Name="Installed" Grid.Row="2" SelectionMode="Extended" SelectionChanged="ModeSelected" ToolTip="Ctrl+click or Shift+click to select multiple gamemodes" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" ToolTip="{Binding Name}" />
                                                <TextBlock Loaded="ModeOriginLoaded" Foreground="#B9B7D6" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                                    <Button Content="Select all" Click="SelectAllModes" />
                                    <Button x:Name="ClearModesButton" Content="Clear selection" IsEnabled="False" Click="ClearModeSelection" />
                                    <Button Content="New mode" Click="NewMode" />
                                    <Button Content="Community presets" Click="Presets" />
                                    <Button Content="History" Click="ShowModeHistory" />
                                    <Button x:Name="DeleteModesButton" Content="Delete selected modes" IsEnabled="False" Foreground="#FFB9B9" Click="DeleteModeClick" />
                                </WrapPanel>
                            </Grid>
                            <GridSplitter Grid.Column="1" Style="{StaticResource PaneDivider}" AutomationProperties.Name="Resize installed modes sidebar" DragCompleted="PaneResizeCompleted" KeyUp="PaneResizeKeyUp" />
                            <Grid x:Name="ModeEditor" Grid.Column="2" Margin="8,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="320" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Mode name" Margin="0,0,0,4" />
                                        <TextBox x:Name="ModeName" TextChanged="NameChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                        <TextBlock Text="Base mode" Margin="0,0,0,4" />
                                        <ComboBox local:DropDownSearch.Enabled="True" x:Name="Base" DisplayMemberPath="Name" SelectedValuePath="Id" MaxDropDownHeight="420" IsTextSearchEnabled="False" TextSearch.TextPath="Name" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}" />
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Grid.Row="1" Margin="0,12,0,12">
                                    <TextBlock Text="Rules" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="RulePhase" Width="170" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="RulePhaseChanged" AutomationProperties.Name="Rule phase" />
                                    <Button Content="Reset opened values" Click="ResetOpened" />
                                </WrapPanel>
                                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                                    <TextBlock Text="Search all settings" Foreground="#B9B7D6" FontSize="12" Margin="0,0,0,4" />
                                    <DockPanel>
                                        <Button x:Name="ClearSettingsSearchButton" DockPanel.Dock="Right" Content="Clear" Click="ClearSettingsSearch" Margin="8,0,0,0" IsEnabled="False" />
                                        <TextBox x:Name="SettingsSearch" MaxLength="160" TextChanged="SettingsSearchChanged" KeyDown="SettingsSearchKeyDown" ToolTip="Search settings, descriptions, categories and loadout choices" AutomationProperties.Name="Search all gamemode settings" />
                                    </DockPanel>
                                    <TextBlock x:Name="SettingsSearchStatus" Foreground="#B9B7D6" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                                <Grid x:Name="SettingsPanes" Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="CategorySidebar" Width="135" MinWidth="105" MaxWidth="260" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" MinWidth="420" />
                                    </Grid.ColumnDefinitions>
                                    <ListBox x:Name="Categories" SelectionChanged="CategoryChanged" />
                                    <GridSplitter Grid.Column="1" Style="{StaticResource PaneDivider}" AutomationProperties.Name="Resize settings categories" DragCompleted="PaneResizeCompleted" KeyUp="PaneResizeKeyUp" />
                                    <ScrollViewer x:Name="SettingsScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
                                        <StackPanel x:Name="Rows" />
                                    </ScrollViewer>
                                </Grid>
                                <WrapPanel Grid.Row="4" Margin="0,12,0,0">
                                    <Button x:Name="SaveButton" Content="Save to game" Background="{StaticResource Gold}" Foreground="#171027" Click="SaveToGame" />
                                    <Button Content="Duplicate" Click="Duplicate" />
                                    <Button Content="Publish mode" Click="ShareEditorMode" />
                                    <TextBlock x:Name="DirtyLabel" VerticalAlignment="Center" Foreground="#F3BE4F" Margin="6" />
                                </WrapPanel>
                            </Grid>
                            <Grid x:Name="ModeHistoryPanel" Grid.Column="2" Margin="8,0,0,0" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <Button Content="Back to editor" Click="BackToModeEditor" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="HistoryContext" Text="Gamemode history" FontSize="20" TextWrapping="Wrap" Margin="0,8,0,6" />
                                    <TextBlock Text="Compare saved snapshots. Restore loads a mode into the editor for review." Foreground="#B9B7D6" TextWrapping="Wrap" Margin="0,0,0,12" />
                                </StackPanel>
                                <StackPanel Grid.Row="1">
                                    <TextBlock Text="Before" Margin="0,0,0,4" />
                                    <ComboBox x:Name="BeforeRevision" Margin="0,0,0,10" SelectionChanged="RevisionChanged" />
                                    <TextBlock Text="After" Margin="0,0,0,4" />
                                    <ComboBox x:Name="AfterRevision" Margin="0,0,0,12" SelectionChanged="RevisionChanged" />
                                </StackPanel>
                                <TextBox Grid.Row="2" x:Name="DiffText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                                <Button Grid.Row="3" Content="Restore selected mode from older snapshot" HorizontalAlignment="Left" Margin="0,12,0,0" Click="RestoreRevision" />
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Community">
                        <ContentControl x:Name="ModeCommunityHost">
                            <Grid Margin="16" x:Name="LibraryWorkspace" TextElement.FontWeight="Normal">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <WrapPanel>
                                    <Button x:Name="LibrarySignInButton" Content="Sign in with Discord" Click="LibrarySignIn" />
                                    <Button x:Name="LibrarySignOutButton" Content="Sign out" Click="LibrarySignOut" Visibility="Collapsed" />
                                    <Button Content="Cancel" Click="LibraryCancel" x:Name="LibraryCancelButton" IsEnabled="False" />
                                    <TextBlock x:Name="LibraryAccount" VerticalAlignment="Center" Margin="8,0" />
                                </WrapPanel>
                                <TextBlock x:Name="LibraryStatus" Grid.Row="1" Text="Public maps, modes and bundles. Local editing stays offline; publishing is explicit." Foreground="#B9B7D6" TextWrapping="Wrap" Margin="0,6,0,12" />
                                <Grid Grid.Row="2">
                                    <Grid Margin="12" x:Name="LibraryBrowserPanel">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="350" MinWidth="240" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" MinWidth="400" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
                                            <WrapPanel>
                                                <Button Content="Refresh" Click="LibraryRefresh" />
                                                <Button Content="Publish local…" Click="ShowNewPublication" />
                                                <Button x:Name="RefreshCatalogButton" Content="Refresh community catalog" Click="RefreshCatalogClick" />
                                                <Button Content="Load more" Click="LibraryMore" />
                                                <Button Content="Import package" Click="LibraryImportPackage" />
                                                <ComboBox x:Name="LibrarySource" SelectedIndex="0" SelectionChanged="LibrarySourceChanged" Margin="0,0,8,6" Width="180">
                                                    <ComboBoxItem Content="All sources" Tag="all" />
                                                    <ComboBoxItem Content="Architects catalog" Tag="catalog" />
                                                    <ComboBoxItem Content="SGL uploads" Tag="sgl" />
                                                </ComboBox>
                                            </WrapPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" MinWidth="120" />
                                                    <ColumnDefinition Width="*" MinWidth="100" />
                                                    <ColumnDefinition Width="1.3*" MinWidth="130" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="Search" FontSize="12" Foreground="#B9B7D6" />
                                                    <TextBox x:Name="LibrarySearch" Margin="0,4,0,0" TextChanged="LibrarySearchChanged" ToolTip="Search titles, descriptions, creators and tags" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock Text="Tag" FontSize="12" Foreground="#B9B7D6" />
                                                    <TextBox x:Name="LibraryTag" Margin="0,4,0,0" MaxLength="40" KeyDown="LibraryFilterKeyDown" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                                    <TextBlock Text="Creator" FontSize="12" Foreground="#B9B7D6" />
                                                    <TextBox x:Name="LibraryCreator" Margin="0,4,0,0" MaxLength="100" KeyDown="LibraryFilterKeyDown" />
                                                </StackPanel>
                                                <WrapPanel Grid.Column="3" VerticalAlignment="Bottom">
                                                    <Button x:Name="ApplyLibraryFiltersButton" Content="Apply filters" Click="LibraryRefresh" />
                                                    <Button x:Name="ClearLibraryFiltersButton" Content="Clear filters" Click="LibraryClearFilters" />
                                                </WrapPanel>
                                            </Grid>
                                        </StackPanel>
                                        <Grid Margin="0,0,8,0" Grid.Row="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ListBox x:Name="LibraryItems" Grid.Row="0" SelectionChanged="LibraryItemSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Extended">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel>
                                                            <Border DockPanel.Dock="Left" Width="104" Height="72" Margin="0,0,10,0" Background="#10152B" ClipToBounds="True">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="mode">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <local:SharedMapImage x:Name="Thumbnail" Catalog="{Binding Catalog}" PreviewDescriptor="{Binding Preview}" Stretch="UniformToFill" />
                                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#B9B7D6">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Text" Value="No image" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsLoading, ElementName=Thumbnail}" Value="True">
                                                                                        <Setter Property="Text" Value="Loading…" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding HasPreview, ElementName=Thumbnail}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Label}" Foreground="#B9B7D6" FontSize="12" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding TagSummary}" Foreground="{StaticResource Gold}" FontSize="12" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Gold}" FontSize="12" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                                <Button Content="Select all" Click="SelectAllLibraryItems" />
                                                <Button x:Name="ClearLibrarySelectionButton" Content="Clear selection" IsEnabled="False" Click="ClearLibrarySelection" />
                                                <Button x:Name="InstallLibrarySelectionButton" Content="Install selected" IsEnabled="False" Click="InstallLibrarySelection" Background="{StaticResource Gold}" Foreground="#171027" />
                                            </WrapPanel>
                                        </Grid>
                                        <GridSplitter Grid.Column="1" Style="{StaticResource PaneDivider}" AutomationProperties.Name="Resize shared library list" Grid.Row="1" />
                                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0" Grid.Row="1">
                                            <StackPanel>
                                                <StackPanel x:Name="CatalogDetailsPanel" Visibility="Collapsed">
                                                    <Image x:Name="MapPreview" Height="180" Stretch="Uniform" Margin="0,0,0,10" />
                                                    <TextBlock x:Name="MapDetails" Text="Select a community map." TextWrapping="Wrap" Margin="0,0,0,10" />
                                                    <TextBlock x:Name="CatalogTags" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                                    <Button x:Name="EditCatalogTagsButton" Content="Edit local tags…" Click="EditMapTags" IsEnabled="False" />
                                                    <TextBlock Text="{Binding Text, ElementName=MapStatus}" TextWrapping="Wrap" Foreground="#B9B7D6" Margin="0,8,0,12" />
                                                    <Button Content="Catalog website" Click="MapWebsiteClick" />
                                                </StackPanel>
                                                <StackPanel x:Name="SharedDetailsPanel" Visibility="Collapsed">
                                                    <WrapPanel>
                                                        <Button x:Name="OpenInstalledPublicationButton" Content="Open installed copy" Click="OpenInstalledPublication" IsEnabled="False" />
                                                        <Button x:Name="UpdatePublicationButton" Content="Publish update" IsEnabled="False" Click="PreparePublicationUpdate" />
                                                        <Button x:Name="ForkPublicationButton" Content="Save as my version" IsEnabled="False" Click="PreparePublicationFork" />
                                                    </WrapPanel>
                                                    <TextBlock x:Name="LibraryDetails" Text="Select a shared item." TextWrapping="Wrap" Margin="0,16,0,12" />
                                                    <Border x:Name="LibraryMapPreviewPanel" Visibility="Collapsed" Background="#10152B" Margin="0,0,0,14">
                                                        <Grid Height="230">
                                                            <local:SharedMapImage x:Name="LibraryMapPreview" Stretch="Uniform" />
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B9B7D6">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="No preview available" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsLoading, ElementName=LibraryMapPreview}" Value="True">
                                                                                <Setter Property="Text" Value="Loading preview…" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding HasPreview, ElementName=LibraryMapPreview}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="Selected revision" Margin="0,0,0,4" />
                                                    <ComboBox x:Name="LibraryRevisions" DisplayMemberPath="Label" Margin="0,0,0,6" SelectionChanged="SharedRevisionSelected" />
                                                    <TextBlock x:Name="LibraryRevisionAttribution" Foreground="#B9B7D6" TextWrapping="Wrap" Margin="0,0,0,10" />
                                                    <TextBlock Text="Compare with revision" Margin="0,0,0,4" />
                                                    <ComboBox x:Name="LibraryCompareRevision" DisplayMemberPath="Label" Margin="0,0,0,10" />
                                                    <Button Content="Load older revisions" Click="LibraryOlderRevisions" HorizontalAlignment="Left" />
                                                    <WrapPanel>
                                                        <Button Content="Install selected revision" Background="{StaticResource Gold}" Foreground="#171027" Click="LibraryInstall" />
                                                        <Button Content="Compare local mode" Click="LibraryCompare" />
                                                        <Button Content="Compare revisions" Click="LibraryCompareVersions" />
                                                        <Button Content="Creator's Discord profile" Click="LibraryCreatorProfile" />
                                                        <Button Content="Export package" Click="LibraryExport" />
                                                    </WrapPanel>
                                                    <TextBox x:Name="LibraryDiff" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Height="180" VerticalScrollBarVisibility="Auto" Margin="0,8,0,12" />
                                                    <TextBlock Text="Portable sharing" FontSize="18" Margin="0,12,0,8" />
                                                    <TextBlock Text="Publish local content or import a .sglpack file. Exported packages preserve creator credits." TextWrapping="Wrap" Foreground="#B9B7D6" />
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="PublicationEditor" Visibility="Collapsed">
                                        <StackPanel Margin="20" MaxWidth="850" HorizontalAlignment="Stretch">
                                            <Button Content="Back to uploads" HorizontalAlignment="Left" Click="BackToUploads" />
                                            <TextBlock Text="Publish selected content" FontSize="20" Margin="0,0,0,12" />
                                            <TextBlock Text="Content" />
                                            <ComboBox x:Name="PublishKind" SelectedIndex="1" Margin="0,5,0,10" SelectionChanged="PublishKindChanged">
                                                <ComboBoxItem Content="Map" Tag="map" />
                                                <ComboBoxItem Content="Gamemode" Tag="mode" />
                                                <ComboBoxItem Content="Map + gamemode bundle" Tag="bundle" />
                                            </ComboBox>
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedItem.Tag, ElementName=PublishKind}" Value="mode">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="Local map" />
                                                <ComboBox x:Name="PublishMap" DisplayMemberPath="Name" Margin="0,5,0,10" SelectionChanged="PublishSourceChanged" />
                                                <TextBlock x:Name="PublishMapTags" Text="Map tags are included when publishing or exporting." TextWrapping="Wrap" Foreground="{StaticResource Gold}" Margin="0,0,0,10" />
                                            </StackPanel>
                                            <TextBlock Text="Local gamemode" />
                                            <ComboBox x:Name="PublishMode" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,5,0,10" SelectionChanged="PublishSourceChanged" />
                                            <TextBlock Text="Publication" />
                                            <ComboBox x:Name="PublishAction" SelectedIndex="0" Margin="0,5,0,10">
                                                <ComboBoxItem Content="New item" Tag="new" />
                                                <ComboBoxItem Content="New revision of selected shared item" Tag="update" />
                                                <ComboBoxItem Content="My own version of selected shared item" Tag="fork" />
                                            </ComboBox>
                                            <TextBlock Text="Title" />
                                            <TextBox x:Name="PublishTitle" MaxLength="120" Margin="0,5,0,10" />
                                            <TextBlock Text="Description" />
                                            <TextBox x:Name="PublishDescription" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" Height="75" VerticalContentAlignment="Top" Margin="0,5,0,10" />
                                            <TextBlock Text="Original creator credits" />
                                            <TextBox x:Name="PublishCredits" MaxLength="1000" Margin="0,5,0,10" />
                                            <TextBlock Text="What changed?" />
                                            <TextBox x:Name="PublishNote" Text="Initial publication" MaxLength="1000" Margin="0,5,0,10" />
                                            <TextBlock Text="Visibility" />
                                            <ComboBox x:Name="PublishVisibility" SelectedIndex="0" Margin="0,5,0,12">
                                                <ComboBoxItem Content="Private · only your account" Tag="private" />
                                                <ComboBoxItem Content="Public · shown in the community library" Tag="public" />
                                            </ComboBox>
                                            <TextBlock Text="A bundle publishes the selected map and mode as needed, then pins their exact revisions. Existing creator credits are retained. Game-save ownership and local file paths are not uploaded." TextWrapping="Wrap" Foreground="#B9B7D6" Margin="0,0,0,12" />
                                            <WrapPanel>
                                                <Button Content="Publish" Background="{StaticResource Gold}" Foreground="#171027" Click="LibraryPublish" />
                                                <Button Content="Export local package" Click="LibraryExportLocal" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </ContentControl>
                    </TabItem>
                    <TabItem Header="My uploads">
                        <ContentControl x:Name="ModeUploadsHost" />
                    </TabItem>
                </TabControl>
                </Grid>
            </TabItem>
            <TabItem x:Name="MapsTab" Header="Maps">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Close Splitgate to change maps; changes apply on the next game launch." TextWrapping="Wrap" Foreground="#B9B7D6" Margin="16,8,0,8"/>
                <TabControl Grid.Row="1" Margin="0" SelectionChanged="ContentViewChanged" x:Name="MapViews" Style="{StaticResource WorkspaceViews}">
                    <TabItem Header="Installed">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <WrapPanel x:Name="MapLocalToolbar">
                                <Button Content="Import map .bin" Click="ImportMapClick" />
                                <Button Content="Import package" Click="LibraryImportPackage" />
                                <Button Content="Publish map" Click="ShareInstalledMap" />
                                <TextBlock Text="Tag" VerticalAlignment="Center" Margin="8,0,8,6" />
                                <ComboBox x:Name="MapTagFilter" Width="180" DisplayMemberPath="Name" ToolTip="Filter community and installed maps by a local tag" Margin="0,0,8,6" SelectionChanged="MapTagFilterChanged" />
                                <Button x:Name="EditMapTagsButton" Content="Edit local tags…" Click="EditMapTags" IsEnabled="False" ToolTip="Select a community or installed map to edit its tags" />
                            </WrapPanel>
                            <TextBlock x:Name="MapStatus" Grid.Row="1" Text="Select installed maps to manage local tags, sharing and paired gamemodes." TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#B9B7D6" />
                            <Grid x:Name="MapPanes" Grid.Row="2" TextElement.FontWeight="Normal">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="300" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition x:Name="MapDetailsPane" Width="380" MinWidth="280" MaxWidth="750" />
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="InstalledMapListPanel" Margin="0,0,8,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="InstalledMapSearch" ToolTip="Search installed maps by name, author or local tags" TextChanged="InstalledMapSearchChanged" Margin="0,0,0,8" Grid.Row="0" />
                                    <ListBox x:Name="InstalledMaps" SelectionMode="Extended" SelectionChanged="InstalledMapSelected" ToolTip="Ctrl+click or Shift+click to select multiple installed maps" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="1">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" ToolTip="{Binding Name}" />
                                                    <TextBlock Text="{Binding TagSummary}" Foreground="{StaticResource Gold}" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                        <Button Content="Select all" Click="SelectAllInstalledMaps" />
                                        <Button x:Name="ClearInstalledMapsButton" Content="Clear selection" IsEnabled="False" Click="ClearInstalledMapSelection" />
                                        <Button x:Name="DeleteMapsButton" Content="Delete selected local maps" IsEnabled="False" Foreground="#FFB9B9" Click="DeleteMapClick" Margin="0,8,8,6" />
                                    </WrapPanel>
                                </Grid>
                                <GridSplitter Grid.Column="1" Style="{StaticResource PaneDivider}" AutomationProperties.Name="Resize installed maps and details" DragCompleted="PaneResizeCompleted" KeyUp="PaneResizeKeyUp" />
                                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
                                    <StackPanel x:Name="InstalledMapDetails">
                                        <Border x:Name="InstalledMapPreviewPanel" Visibility="Collapsed" Background="#171A37" Margin="0,0,0,14" CornerRadius="4">
                                            <Grid Height="220">
                                                <local:InstalledMapImage x:Name="InstalledMapPreview" Stretch="Uniform" />
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B9B7D6">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="No screenshot available" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLoading, ElementName=InstalledMapPreview}" Value="True">
                                                                    <Setter Property="Text" Value="Loading screenshot…" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasPreview, ElementName=InstalledMapPreview}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="MapLocalDetails" Text="Select one installed map to see its details." TextWrapping="Wrap" Margin="0,0,0,14" />
                                        <TextBlock x:Name="MapTagTitle" Text="Local tags" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        <TextBlock x:Name="MapTagDetails" Text="Select a map to edit its tags." Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <TextBlock Text="Paired gamemodes" FontSize="18" Margin="0,18,0,8" />
                                        <TextBlock Text="Choose the map and gamemode separately in the game lobby." TextWrapping="Wrap" Foreground="#B9B7D6" Margin="0,0,0,8" />
                                        <ComboBox x:Name="MapModeChoice" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,6" />
                                        <WrapPanel>
                                            <Button Content="Associate" Click="AssociateMapMode" />
                                            <Button Content="Remove link" Click="UnlinkMapMode" />
                                        </WrapPanel>
                                        <ListBox x:Name="AssociatedModes" DisplayMemberPath="Name" Height="100" Margin="0,8,0,0" MouseDoubleClick="OpenAssociatedMode" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Community">
                        <ContentControl x:Name="MapCommunityHost" />
                    </TabItem>
                    <TabItem Header="My uploads">
                        <ContentControl x:Name="MapUploadsHost" />
                    </TabItem>
                </TabControl>
                </Grid>
            </TabItem>
            <TabItem x:Name="ModsTab" Header="Mods">
                <Grid Margin="16,8,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Mods" FontSize="24" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="1" Text="Close Splitgate to change mods; changes apply on the next game launch." TextWrapping="Wrap" Foreground="#B9B7D6" Margin="0,0,0,12"/>
                    <Grid Grid.Row="2" x:Name="ModsWorkspace">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="300" MinWidth="240"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBox x:Name="ModSearch" TextChanged="ModSearchChanged" ToolTip="Search community and installed mods" Margin="0,0,0,10" AutomationProperties.Name="Search mods"/>
                            <ListBox x:Name="ModList" Grid.Row="1" SelectionChanged="ModSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#B9B7D6" FontSize="12" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Grid.Row="2" Margin="0,10,0,0"><Button x:Name="RefreshModsButton" Content="Refresh mods" Click="RefreshModsClick"/><Button Content="Mod documentation" Click="OpenModsDocs"/></WrapPanel>
                        </Grid>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8,0,8,0">
                                <TextBlock x:Name="ModTitle" Text="Select a mod" FontSize="22" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ModDescription" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock x:Name="ModScope" Foreground="#B9B7D6" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock x:Name="ModRuntimeStatus" Foreground="#B9B7D6" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <WrapPanel Margin="0,12,0,12">
                                    <Button x:Name="EnableModButton" Content="Enable" Click="EnableModClick" IsEnabled="False" Background="{StaticResource Gold}" Foreground="#171027"/>
                                    <Button x:Name="DisableModButton" Content="Disable" Click="DisableModClick" IsEnabled="False"/>
                                    <Button x:Name="UpdateModButton" Content="Update" Click="UpdateModClick" IsEnabled="False"/>
                                    <Button x:Name="OpenModFolderButton" Content="Open mod folder" Click="OpenModFolder" IsEnabled="False"/>
                                </WrapPanel>
                                <StackPanel x:Name="ModConfigurationPanel" Visibility="Collapsed">
                                    <TextBlock Text="Configuration" FontSize="18" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="ModConfigFiles" DisplayMemberPath="Path" SelectionChanged="ModConfigSelected"/>
                                    <TextBlock x:Name="ModConfigHint" TextWrapping="Wrap" Foreground="#B9B7D6" Margin="0,8,0,8"/>
                                    <TextBox x:Name="ModConfigText" AcceptsReturn="True" AcceptsTab="True" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" FontFamily="Consolas" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="260" MaxLength="1000000" TextChanged="ModConfigurationChanged"/>
                                    <WrapPanel Margin="0,8,0,12"><Button x:Name="SaveModConfigButton" Content="Save configuration" Click="SaveModConfiguration" IsEnabled="False"/><Button Content="Reload configuration" Click="ReloadModConfiguration"/></WrapPanel>
                                </StackPanel>
                                <TextBlock Text="Mod backups" FontSize="18" Margin="0,12,0,6"/>
                                <ComboBox x:Name="ModBackups" DisplayMemberPath="Label" MaxDropDownHeight="240"/>
                                <WrapPanel Margin="0,8,0,0"><Button x:Name="RestoreModBackupButton" Content="Restore selected mod backup" Click="RestoreModBackup" IsEnabled="False"/><Button x:Name="OpenModBackupsButton" Content="Open mod backups" Click="OpenModBackups" IsEnabled="False"/></WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <TextBlock x:Name="ModsStatus" Grid.Row="3" Text="Discovering community mods…" TextWrapping="Wrap" Foreground="#B9B7D6" Margin="0,12,0,0"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="SettingsTab" Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <CheckBox x:Name="AutoUpdate" Content="Automatically check, download and apply verified releases at startup" Click="UpdatePreference" />
                        <WrapPanel Margin="0,12,0,12">
                            <Button Content="Check for updates" Click="CheckUpdates" />
                            <Button Content="Setup &amp; Windows Security guide" Click="OpenGuide" />
                            <Button Content="Report a bug" Click="ReportBug" />
                            <Button Content="Open SGL data folder" Click="OpenData" />
                            <Button Content="Reset pane widths" Click="ResetPaneWidths" />
                        </WrapPanel>
                        <TextBlock Text="Splitgate game folder" Foreground="#B9B7D6" Margin="0,12,0,4"/>
                        <DockPanel x:Name="GameFolderControls" Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseModGame" Margin="8,0,0,0"/>
                            <Button DockPanel.Dock="Right" Content="Find in Steam" Click="FindModGame" Margin="8,0,0,0"/>
                            <TextBox x:Name="ModGameFolder" IsReadOnly="True" ToolTip="Game installation, separate from the CloudSave folder"/>
                        </DockPanel>
                        <TextBlock Text="CloudSave folder" FontSize="18" Margin="0,12,0,0" />
                        <Grid Margin="0,8,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="Folder" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button Content="Browse" Click="BrowseFolder" />
                                <Button Content="Refresh / capture changes" Click="RefreshClick" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Backups" FontSize="18" />
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Restores the complete maps and gamemodes list to this backup. Later additions will disappear from the list. A safety backup is made first." TextWrapping="Wrap" Margin="0,0,0,14" />
                            <ListBox x:Name="Backups" Grid.Row="1" Height="200" />
                            <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                                <Button Content="Open backup folder" Click="OpenBackupFolder" />
                                <Button Content="Restore selected backup" Click="RestoreBackup" />
                            </WrapPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="Status" Grid.Row="2" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#B9B7D6" />
    </Grid>
</Window>
